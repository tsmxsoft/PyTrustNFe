<!-- VALIDADO -->
<ConsultarNfseRpsEnvio xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xmlns:xsd="http://www.w3.org/2001/XMLSchema"
            xmlns="http://www.abrasf.org.br/nfse.xsd">
    <IdentificacaoRps>
        <Numero>{{ nfse.rps.numero }}</Numero>
        <Serie>{{ nfse.rps.serie}}</Serie>
        <Tipo>{{ nfse.rps.tipo }}</Tipo>
    </IdentificacaoRps>
    <Prestador>
        <CpfCnpj>
            <Cnpj>{{ nfse.cnpj_prestador }}</Cnpj>
        </CpfCnpj>
        <InscricaoMunicipal>{{ nfse.inscricao_municipal }}</InscricaoMunicipal>
    </Prestador>
</ConsultarNfseRpsEnvio>