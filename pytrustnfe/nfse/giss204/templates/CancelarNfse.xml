<can:CancelarNfseEnvio xmlns:can="http://www.giss.com.br/cancelar-nfse-envio-v2_04.xsd"
    xmlns:tip="http://www.giss.com.br/tipos-v2_04.xsd">
    <can:Pedido>
        <tip:InfPedidoCancelamento Id="1">
            <tip:IdentificacaoNfse>
                <tip:Numero>{{ nfse.rps.numero }}</tip:Numero>
                <tip:CpfCnpj>
                    <tip:Cnpj>{{ nfse.cnpj_prestador }}</tip:Cnpj>
                </tip:CpfCnpj>
                <tip:InscricaoMunicipal>{{ nfse.inscricao_municipal }}</tip:InscricaoMunicipal>
                <tip:CodigoMunicipio>{{ nfse.codigo_municipio }}</tip:CodigoMunicipio>
            </tip:IdentificacaoNfse>
            <tip:CodigoCancelamento>{{ nfse.codigo_cancelamento }}</tip:CodigoCancelamento>
        </tip:InfPedidoCancelamento>
    </can:Pedido>
</can:CancelarNfseEnvio>
